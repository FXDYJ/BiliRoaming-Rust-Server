player-block-list-state {\\n  text-align: center;\\n  color: var(--bpx-fn-color, #00a1d6);\\n  cursor: pointer;\\n}\\n.bpx-player-block-list-delete {\\n  width: 14px;\\n  padding: 0 13px;\\n  text-align: center;\\n  color: var(--bpx-aux-content-font5, #99a2aa);\\n  fill: var(--bpx-aux-block-icon, #99a2aa);\\n  cursor: pointer;\\n}\\n.bpx-player-block-list-sync {\\n  width: 14px;\\n  padding: 0 13px;\\n  color: var(--bpx-aux-content-font5, #99a2aa);\\n  fill: var(--bpx-aux-block-icon, #99a2aa);\\n}\\n.bpx-player-block-list-item {\\n  display: block;\\n  padding: 0 6px;\\n  font-size: 12px;\\n  line-height: 24px;\\n  min-height: 48px;\\n}\\n.bpx-player-block-list-line {\\n  display: flex;\\n  justify-content: space-between;\\n  padding-left: 5px;\\n  height: 24px;\\n  color: var(--bpx-aux-content-font1, #222222);\\n  background: var(--bpx-aux-content-bg, #ffffff);\\n}\\n.bpx-player-block-list-line.bpx-player-disabled {\\n  color: var(--bpx-aux-content-font3, #757575);\\n}\\n.bpx-player-block-list-line.bpx-player-noid .bpx-player-block-list-sync {\\n  position: relative;\\n  cursor: pointer;\\n}\\n.bpx-player-block-list-line.bpx-player-noid .bpx-player-block-list-sync::after {\\n  content: '上传屏蔽词';\\n  opacity: 0;\\n  display: inline-block;\\n  position: absolute;\\n  right: 0;\\n  top: -24px;\\n  padding: 2px 8px;\\n  background: rgba(0, 0, 0, 0.6);\\n  border-radius: 2px;\\n  color: #fff;\\n  word-break: keep-all;\\n  transition: all 0.3s;\\n  pointer-events: none;\\n}\\n.bpx-player-block-list-line.bpx-player-noid .bpx-player-block-list-sync:hover::after {\\n  opacity: 1;\\n  top: -34px;\\n}\\n.bpx-player-block-list-line:hover {\\n  background: var(--bpx-aux-button-bg, #e5e9ef);\\n}\\n.bpx-player-date-picker {\\n  position: absolute;\\n  width: 242px;\\n  height: 212px;\\n  cursor: default;\\n  display: none;\\n  background: var(--bpx-aux-footer-bg, #f4f4f4);\\n  border: 1px solid var(--bpx-aux-float-border, #e5e9ef);\\n  border-radius: 4px;\\n  box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.14);\\n  z-index: 10001;\\n  bottom: 50px;\\n  left: 50%;\\n  text-align: left;\\n  transform: translateX(-50%);\\n}\\n.bpx-player-date-picker.bpx-player-show {\\n  display: block;\\n}\\n.bpx-player-date-picker-header {\\n  border-bottom: 1px solid var(--bpx-aux-line-border, #e5e9ef);\\n  height: 30px;\\n  line-height: 30px;\\n  text-align: center;\\n  color: var(--bpx-aux-content-font2, #6d757a);\\n}\\n.bpx-player-date-picker-header > span {\\n  margin: 0 3px;\\n  font-size: 13px;\\n}\\n.bpx-player-date-picker-btn {\\n  position: absolute;\\n  top: 7px;\\n  width: 16px;\\n  height: 16px;\\n  font-size: 0;\\n  line-height: 0;\\n  color: var(--bpx-aux-content-font2, #6d757a);\\n  fill: var(--bpx-aux-float-icon, #6d757a);\\n  cursor: pointer;\\n}\\n.bpx-player-date-picker-btn.bpx-player-disabled {\\n  pointer-events: none;\\n  cursor: default;\\n}\\n.bpx-player-date-picker-btn.btn-prev {\\n  left: 18px;\\n}\\n.bpx-player-date-picker-btn.btn-next {\\n  right: 18px;\\n}\\n.bpx-player-date-picker-btn > span {\\n  pointer-events: none;\\n}\\n.bpx-player-date-picker-body {\\n  position: relative;\\n  padding: 2px 1px 1px 2px;\\n}\\n.bpx-player-date-picker-week .bpx-player-date-picker-day {\\n  color: var(--bpx-aux-content-font1, #222222);\\n}\\n.bpx-player-date-picker-day {\\n  float: left;\\n  width: 24px;\\n  height: 24px;\\n  margin: 0 4px;\\n  text-align: center;\\n  line-height: 24px;\\n  color: var(--bpx-aux-content-font4, #ccd0d7);\\n  border: 1px solid var(--bpx-aux-footer-bg, #f4f4f4);\\n  margin-top: -1px;\\n  z-index: 1;\\n  position: relative;\\n  font-size: 12px;\\n  border-radius: 4px;\\n  pointer-events: none;\\n}\\n.bpx-player-date-picker-day.day-enable {\\n  color: var(--bpx-aux-content-font2, #6d757a);\\n  cursor: pointer;\\n  pointer-events: auto;\\n}\\n.bpx-player-date-picker-day.day-enable.bpx-player-active {\\n  pointer-events: none;\\n}\\n.bpx-player-date-picker-day.day-enable.bpx-player-active,\\n.bpx-player-date-picker-day.day-enable:hover {\\n  border-color: var(--bpx-primary-color, #00a1d6);\\n  color: var(--bpx-primary-color, #00a1d6);\\n  z-index: 11;\\n}\\n\",\"@import (reference) '../../base/global';\\n@import (reference) '../../base/theme';\\n\\n.@{ppx}-auxiliary {\\n    &.@{ppx}-unlogin {\\n        .dm-info-report-btn {\\n            display: none !important;\\n        }\\n    }\\n    .@{ppx}-dm {\\n        display: none;\\n        height: 100%;\\n        // 管理员设置\\n        &-management {\\n            text-align: center;\\n            color: @aux-content-font3;\\n            fill: @aux-content-font3;\\n            background-color: @aux-content-bg;\\n            display: flex;\\n            justify-content: space-between;\\n\\n            .@{ppx}-up-btn {\\n                display: flex;\\n                flex-direction: column;\\n                justify-content: center;\\n                align-items: center;\\n                width: 80px;\\n                height: 52px;\\n                color: @aux-footer-font;\\n                border-bottom: 1px solid @aux-line-border;\\n                box-sizing: border-box;\\n                cursor: pointer;\\n                transition: color 0.3s;\\n\\n                &:hover {\\n                    color: @primary-color;\\n                    fill: @primary-color;\\n                }\\n\\n                span {\\n                    display: inline-block;\\n                    width: 100%;\\n                    pointer-events: none;\\n                    &.@{ppx}-up-btn-icon {\\n                        width: 15px;\\n                        margin-bottom: 4px;\\n                    }\\n                }\\n            }\\n        }\\n        // 列表标题\\n        &-function {\\n            background-color: @aux-content-bg;\\n            position: relative;\\n            overflow: hidden;\\n            z-index: 1;\\n            display: flex;\\n\\n            .@{ppx}-dm-btn-time,\\n            .@{ppx}-dm-btn-dm,\\n            .@{ppx}-dm-btn-date {\\n                font-size: 12px;\\n                color: @aux-content-font2;\\n                height: 32px;\\n                border: 0;\\n                padding: 0 6px;\\n                line-height: 32px;\\n                cursor: pointer;\\n                display: inline-block;\\n                box-sizing: border-box;\\n                position: relative;\\n\\n                & > span {\\n                    pointer-events: none;\\n                }\\n            }\\n\\n            .@{ppx}-dm-btn-time {\\n                width: 60px;\\n                text-align: left;\\n                padding-left: 16px;\\n                padding-right: 0;\\n            }\\n\\n            .@{ppx}-dm-btn-dm {\\n                // width: 170px;\\n                flex: auto;\\n                text-align: left;\\n            }\\n\\n            .@{ppx}-dm-btn-date {\\n                width: 88px;\\n                text-align: left;\\n            }\\n            .@{ppx}-dm-btn-icon {\\n                display: none;\\n                width: 10px;\\n                height: 10px;\\n                position: absolute;\\n                top: 11px;\\n                right: 5px;\\n                font-size: 0;\\n                line-height: 0;\\n                transform-origin: center;\\n            }\\n\\n            &.@{ppx}-order-rotate {\\n                .@{ppx}-dm-btn-icon {\\n                    transform: rotate(180deg);\\n                }\\n            }\\n            &.@{ppx}-order-stime {\\n                .@{ppx}-dm-btn-time {\\n                    .@{ppx}-dm-btn-icon {\\n                        display: inline-block;\\n                    }\\n                }\\n            }\\n            &.@{ppx}-order-text {\\n                .@{ppx}-dm-btn-dm {\\n                    .@{ppx}-dm-btn-icon {\\n                        display: inline-block;\\n                    }\\n                }\\n            }\\n            &.@{ppx}-order-date {\\n                .@{ppx}-dm-btn-date {\\n                    .@{ppx}-dm-btn-icon {\\n                        display: inline-block;\\n                        right: 16px;\\n                    }\\n                }\\n            }\\n            .@{ppx}-dm-multiple {\\n                background-color: @aux-content-bg;\\n                position: absolute;\\n                top: -10px;\\n                left: 0;\\n                padding-left: 10px;\\n                height: 32px;\\n                width: 100%;\\n                opacity: 0;\\n                visibility: hidden;\\n                box-sizing: border-box;\\n                border: none;\\n                transition: all 0.2s;\\n                color: @aux-content-font5;\\n                line-height: 32px;\\n                z-index: 2;\\n\\n                &.@{ppx}-show {\\n                    top: 0;\\n                    opacity: 1;\\n                    visibility: visible;\\n                }\\n\\n                &-cancel,\\n                &-submit {\\n                    position: absolute;\\n                    top: 5px;\\n                    line-height: 22px;\\n                    width: 50px;\\n                    padding: 0 4px;\\n                    border-radius: 2px;\\n                    cursor: pointer;\\n\\n                    &:hover {\\n                        color: #fff;\\n                        background: @primary-color;\\n                    }\\n                }\\n                &-cancel {\\n                    right: 88px;\\n                }\\n\\n                &-submit {\\n                    right: 12px;\\n                }\\n            }\\n\\n            .@{ppx}-dm-protect-multiple-control {\\n                background-color: #fff;\\n                position: absolute;\\n                top: 0;\\n                left: 0;\\n                height: 32px;\\n                width: 100%;\\n                display: none;\\n\\n                &-title {\\n                    float: left;\\n                    height: 32px;\\n                    color: @color-font-sub;\\n                    margin-left: 10px;\\n                    line-height: 32px;\\n                }\\n\\n                &-cancel {\\n                    position: absolute;\\n                    top: 5px;\\n                    width: 26px;\\n                    right: 64px;\\n                }\\n\\n                &-protect {\\n                    position: absolute;\\n                    top: 5px;\\n                    width: 26px;\\n                    right: 12px;\\n                }\\n            }\\n        }\\n\\n        &-wrap {\\n            background-color: @aux-content-bg;\\n            position: relative;\\n            .bscroll-vertical-scrollbar {\\n                width: 6px !important;\\n            }\\n            .bscroll-indicator {\\n                border: none !important;\\n                background: @color-scroll-bg !important;\\n                cursor: pointer;\\n            }\\n            .bscroll-vertical-scrollbar.mousedown {\\n                opacity: 1 !important;\\n                background: @aux-content-bg !important;\\n            }\\n            &:hover {\\n                .bscroll-vertical-scrollbar {\\n                    opacity: 1 !important;\\n                    background: @aux-content-bg !important;\\n                }\\n            }\\n        }\\n        .@{ppx}-no-dm {\\n            text-align: center;\\n            color: @aux-content-font1;\\n        }\\n        &.@{ppx}-hide-status {\\n            .@{ppx}-dm-load-status {\\n                display: none;\\n            }\\n            .@{ppx}-dm-btn-history {\\n                display: block;\\n            }\\n        }\\n        &-load-status {\\n            position: absolute;\\n            top: 0;\\n            left: 0;\\n            background: @aux-content-bg;\\n            width: 100%;\\n            height: 200px;\\n            text-align: center;\\n            z-index: 2;\\n            color: @aux-content-font1;\\n            .@{ppx}-reset {\\n                color: @fn-color;\\n                cursor: pointer;\\n                &:hover {\\n                    color: @fn-hover-color;\\n                }\\n            }\\n            &.@{ppx}-dm-close {\\n                margin-top: -32px;\\n                padding-top: 32px;\\n            }\\n        }\\n\\n        &-container {\\n            height: 100%;\\n            overflow: hidden;\\n\\n            .bui-long-list-item-selected {\\n                .dm-info-row {\\n                    &:before {\\n                        position: absolute;\\n                        top: 0;\\n                        left: 0;\\n                        width: 100%;\\n                        height: 100%;\\n                        content: '';\\n                        opacity: 0.1;\\n                        background-color: @dmsend-hint-icon;\\n                    }\\n                    &.dm-info-row-block {\\n                        background: transparent;\\n                    }\\n                }\\n            }\\n            .dm-info-row {\\n                display: flex;\\n                line-height: 24px;\\n                height: 24px;\\n                font-size: 12px;\\n                user-select: none;\\n                cursor: pointer;\\n                position: relative;\\n                color: @aux-content-font2;\\n\\n                span {\\n                    vertical-align: top;\\n                    padding: 0 6px;\\n                    box-sizing: border-box;\\n                    display: inline-block;\\n                    pointer-events: none;\\n\\n                    .dm-info-select-state {\\n                        display: none;\\n                        background-color: @color-grey-bg-hover;\\n                        position: absolute;\\n                        text-align: left;\\n                        top: 0;\\n                        left: 0;\\n                        width: 100%;\\n                        height: 100%;\\n\\n                        .@{ppx}-iconfont {\\n                            margin-left: 20px;\\n\\n                            &.icon-12checkbox {\\n                                margin-top: 6px;\\n                            }\\n\\n                            &.icon-12select {\\n                                display: none;\\n                            }\\n                        }\\n                    }\\n                }\\n                &.dm-info-row-block {\\n                    span {\\n                        color: @color-disabled;\\n                    }\\n                    .dm-info-report-btn,\\n                    .dm-info-block-btn,\\n                    .dm-info-protect-btn {\\n                        color: @fn-color;\\n                    }\\n                }\\n                .dm-info-time {\\n                    width: 66px;\\n                    position: relative;\\n                    text-align: left;\\n                    overflow: hidden;\\n                    padding-left: 16px;\\n                    flex: none;\\n                }\\n\\n                .dm-info-tips {\\n                    display: none;\\n                    padding-left: 0;\\n                    text-align: right;\\n                    float: right;\\n                    width: 88px;\\n                    padding-right: 22px;\\n                }\\n\\n                .dm-info-dm {\\n                    color: @aux-content-font1;\\n                    // width: 170px;\\n                    flex: auto;\\n                    overflow: hidden;\\n                    white-space: nowrap;\\n                    text-overflow: ellipsis;\\n                    pointer-events: auto;\\n                }\\n\\n                .dm-info-date {\\n                    width: 88px;\\n                    white-space: nowrap;\\n                    overflow: hidden;\\n                    flex: none;\\n                }\\n\\n                .dm-info-uname {\\n                    width: 88px;\\n                    overflow: hidden;\\n                    white-space: nowrap;\\n                    text-overflow: ellipsis;\\n                }\\n\\n                .dm-info-float-layer {\\n                    display: none;\\n                    position: absolute;\\n                    bottom: 2px;\\n                    right: 12px;\\n                    height: 22px;\\n                }\\n\\n                &:hover {\\n                    .dm-info-float-layer {\\n                        display: block;\\n                    }\\n                    .dm-info-date {\\n                        display: none;\\n                    }\\n                    .dm-info-recall-btn,\\n                    .dm-info-report-btn,\\n                    .dm-info-block-btn,\\n                    .dm-info-protect-btn {\\n                        display: inline-block;\\n                    }\\n                }\\n\\n                .dm-info-recall-btn,\\n                .dm-info-report-btn,\\n                .dm-info-block-btn,\\n                .dm-info-protect-btn {\\n                    position: absolute;\\n                    top: 1px;\\n                    right: 10px;\\n                    display: none;\\n                    margin-left: 10px;\\n                    transition: background-color 0.3s;\\n                    width: 70px;\\n                    height: 20px;\\n                    line-height: 20px;\\n                    text-align: center;\\n                    border: 1px solid @fn-color;\\n                    border-radius: 2px;\\n                    color: @fn-color;\\n                    background: @aux-content-bg;\\n                    pointer-events: auto;\\n                    &:hover {\\n                        color: #fff;\\n                        background-color: @primary-color;\\n                    }\\n                }\\n                .dm-info-report-btn {\\n                    &.@{ppx}-db-btn {\\n                        right: 90px;\\n                    }\\n                }\\n                .dm-info-recall-btn {\\n                    &.@{ppx}-db-btn {\\n                        right: 90px;\\n                    }\\n                }\\n\\n                &.dm-info-raw-applied,\\n                &.dm-info-raw-protect {\\n                    .dm-info-protect-btn,\\n                    .dm-info-protect-btn:hover {\\n                        color: @primary-color;\\n                        background-color: transparent;\\n                        cursor: default;\\n                    }\\n                    &:hover .dm-info-date {\\n                        color: transparent;\\n                    }\\n                }\\n                // 特殊弹幕\\n                &-super {\\n                    span {\\n                        &.dm-info-date {\\n                            display: none;\\n                        }\\n                    }\\n                    &:after {\\n                        content: '特殊弹幕';\\n                        display: inline-block;\\n                        width: 70px;\\n                        text-align: right;\\n                        color: @color-disabled;\\n                        padding-right: 32px;\\n                    }\\n                }\\n\\n                &-protect {\\n                    span {\\n                        // background-color: @color-bg-protect;\\n                        background-color: @color-list-caption;\\n                        color: @color-font-caption;\\n                        &.dm-info-block {\\n                            display: none;\\n                        }\\n                    }\\n\\n                    &:hover > span {\\n                        background-color: @color-grey-bg-hover;\\n\\n                        .dm-info-float-layer {\\n                            display: none;\\n                        }\\n                    }\\n\\n                    &:hover span .dm-info-select-state {\\n                        display: none;\\n                    }\\n\\n                    &.bpui-selected {\\n                        span {\\n                            color: @color-gray-22;\\n\\n                            .dm-info-select-state {\\n                                display: none;\\n                            }\\n                        }\\n                    }\\n                }\\n\\n                // 字幕弹幕\\n                &-caption {\\n                    color: @color-font-caption;\\n                    span {\\n                        color: @color-font-caption;\\n                        &.dm-info-date {\\n                            display: none;\\n                        }\\n                        &.dm-info-dm {\\n                            color: @color-font-caption;\\n                        }\\n                    }\\n\\n                    &:after {\\n                        content: '字幕弹幕';\\n                        display: inline-block;\\n                        width: 70px;\\n                        text-align: right;\\n                        color: inherit;\\n                        padding-right: 32px;\\n                    }\\n                }\\n\\n                .dm-info-time-edit {\\n                    color: #555;\\n                    width: 42px;\\n                    text-align: center;\\n                    margin: 0 4px 0 14px;\\n                    box-sizing: border-box;\\n                    border: 1px solid #e2e2e2;\\n                }\\n\\n                // 已屏蔽\\n                &-block {\\n                    span {\\n                        &.dm-info-block {\\n                            display: inline-block;\\n                            display: none;\\n                        }\\n                        &.dm-info-time {\\n                            color: @color-disabled;\\n                        }\\n                        &.dm-info-dm {\\n                            color: @color-disabled;\\n                        }\\n                    }\\n\\n                    &:after {\\n                        content: '已屏蔽';\\n                        color: @color-disabled;\\n                        display: inline-block;\\n                        width: 70px;\\n                        text-align: right;\\n                        padding-right: 32px;\\n                    }\\n                }\\n\\n                // 删除中\\n                &-deleting {\\n                    span {\\n                        &.dm-info-date {\\n                            display: none;\\n                        }\\n                    }\\n                    &:after {\\n                        content: '删除中';\\n                        display: inline-block;\\n                        width: 70px;\\n                        text-align: right;\\n                        color: @color-disabled;\\n                        padding-right: 32px;\\n                    }\\n                }\\n                // bas\\n                &-code {\\n                    background-color: @color-list-code;\\n                    color: @color-font-code;\\n                    span {\\n                        color: @color-font-code;\\n                        &.danmaku-info-block {\\n                            display: none;\\n                        }\\n                        &.danmaku-info-date {\\n                            display: none;\\n                        }\\n                    }\\n                    &:after {\\n                        content: 'BAS弹幕';\\n                        display: inline-block;\\n                        width: 70px;\\n                        text-align: right;\\n                        padding-right: 32px;\\n                    }\\n                }\\n            }\\n        }\\n        // 子列表\\n        &-wrap-child {\\n            position: absolute;\\n            top: 0;\\n            left: 0;\\n            bottom: 0;\\n            right: 0;\\n         