olor: @aux-footer-hover-font;\\n            }\\n            &.@{ppx}-disable {\\n                cursor: not-allowed;\\n                pointer-events: none;\\n                color: silver;\\n                background: @aux-button-disabled-bg;\\n            }\\n            .bui-area {\\n                display: block;\\n            }\\n        }\\n    }\\n    .@{ppx}-hasmanage {\\n        .@{ppx}-dm-wrap-child {\\n            top: 52px;\\n        }\\n    }\\n    // 弹幕屏蔽面板  特殊样式\\n    .@{ppx}-report-wrap {\\n        width: 360px;\\n        right: 0;\\n        left: auto;\\n    }\\n}\\n\",\".@{ppx}-auxiliary {\\n    .@{ppx}-adv-danmaku {\\n        height: 100%;\\n        display: none;\\n        & * {\\n            color: @aux-content-font1;\\n            background-color: @aux-content-bg;\\n        }\\n        &-panel {\\n            font-size: 12px;\\n            position: relative;\\n            overflow: hidden;\\n            height: 100%;\\n            box-sizing: border-box;\\n            border-bottom: 1px solid @aux-float-border;\\n            &.mask {\\n                &:after {\\n                    content: '';\\n                    position: absolute;\\n                    top: -60px;\\n                    right: 0;\\n                    bottom: -200px;\\n                    left: 0;\\n                    background: @aux-content-bg;\\n                    opacity: 0.7;\\n                    z-index: 1;\\n                }\\n            }\\n        }\\n        &-group {\\n            border-bottom: 1px solid @aux-line-border;\\n            margin: 0 16px;\\n\\n            &:last-child {\\n                border: none;\\n                padding-bottom: 20px;\\n            }\\n\\n            &-row {\\n                margin: 16px 0;\\n                position: relative;\\n                .clearfix();\\n\\n                &:first-child {\\n                    margin-top: 0;\\n                    padding-top: 16px;\\n                }\\n\\n                &:last-child {\\n                    margin-bottom: 0;\\n                    padding-bottom: 16px;\\n                }\\n            }\\n\\n            &-item {\\n                display: inline-block;\\n                margin-right: 16px;\\n                vertical-align: middle;\\n\\n                .@{ppx}-adv-danmaku-font-family-select {\\n                    z-index: 1;\\n                }\\n            }\\n        }\\n\\n        &-title {\\n            color: @aux-content-font1;\\n            margin-bottom: 8px;\\n            font-weight: bold;\\n            display: block;\\n        }\\n\\n        &-spinner {\\n            width: 65px;\\n            height: 22px;\\n            vertical-align: middle;\\n        }\\n\\n        &-checkbox {\\n            display: inline-block;\\n            line-height: 20px;\\n            vertical-align: middle;\\n            margin-left: 16px;\\n        }\\n\\n        &-btn {\\n            width: 68px;\\n            height: 24px;\\n            line-height: 24px;\\n            border: none;\\n            background-color: @aux-button-bg;\\n            border-radius: 2px;\\n            color: @aux-content-font1;\\n            margin-right: 16px;\\n            &:hover {\\n                color: #fff;\\n                background-color: @primary-color;\\n            }\\n            &.active {\\n                color: #fff;\\n                background-color: @primary-color;\\n                .bui-area {\\n                    color: #fff;\\n                    background-color: @primary-color;\\n                }\\n            }\\n        }\\n\\n        &-color-picker {\\n            justify-content: flex-start;\\n            .bui-color-picker-options {\\n                width: 244px;\\n                margin-top: 6px;\\n                .bui-color-picker-option {\\n                    display: inline-block;\\n                    width: 16px;\\n                    height: 16px;\\n                    box-sizing: border-box;\\n          