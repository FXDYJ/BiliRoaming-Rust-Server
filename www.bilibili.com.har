ound-color: transparent;\\n                padding: 0 8px;\\n                height: 20px;\\n                line-height: 18px;\\n                margin: 0 10px;\\n                cursor: pointer;\\n                transition: all 0.3s ease-in-out;\\n                outline: none;\\n            }\\n        }\\n    }\\n}\\n\",\"@import (reference) 'global';\\n\\n/**\\n * 弹窗层公共样式\\n */\\n.dialog-panel() {\\n    color: @white-10;\\n    border-radius: 4px;\\n    position: absolute;\\n    text-align: center;\\n    z-index: @zIndex-dialog-panel;\\n    -webkit-font-smoothing: antialiased;\\n    background-color: @dialog-panel-bg;\\n}\\n.dialog-panel-title() {\\n    font-size: 16px;\\n    text-align: center;\\n    line-height: 40px;\\n    border-bottom: 1px solid @white-1;\\n}\\n.dialog-panel-close() {\\n    top: 10px;\\n    right: 10px;\\n    width: 22px;\\n    height: 22px;\\n    line-height: 22px;\\n    color: @white-10;\\n    fill: @white-10;\\n    cursor: pointer;\\n    position: absolute;\\n}\\n\\n.clearfix() {\\n    &:after {\\n        content: '';\\n        display: table;\\n        visibility: hidden;\\n        height: 0;\\n        font-size: 0;\\n        clear: both;\\n    }\\n}\\n\\n.textOverflow() {\\n    text-overflow: ellipsis;\\n    overflow: hidden;\\n    white-space: nowrap;\\n}\\n\\n.unselected-checkbox() {\\n    color: @color-gray-21;\\n    label {\\n        &:hover {\\n            box-shadow: none !important;\\n            .bpui-icon-checkbox.icon-12checkbox {\\n                box-shadow: none !important;\\n            }\\n        }\\n    }\\n    &:hover {\\n        .bpui-checkbox-text {\\n            color: @primary-color;\\n        }\\n        .bpui-icon-checkbox.icon-12checkbox {\\n            box-shadow: none;\\n            border: 1px solid @primary-color;\\n        }\\n    }\\n}\\n\\n.select-menu() {\\n    .bpui-selectmenu {\\n        border-radius: 0;\\n    }\\n    .bpui-selectmenu-list {\\n        li {\\n            box-sizing: border-box;\\n   