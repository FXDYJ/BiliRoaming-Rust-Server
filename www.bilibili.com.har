,CACA,UPg2DZ\",\nsourcesContent:[\"/**\\n * Define CSS Variables\\n *\\n * MUST be have `:root` selector only and MUST be CSS-compliant.\\n * MUST be name in kebab-case\\n */\\n:root {\\n    --bpx-video-bgcolor: #000;\\n\\n    // --bpx-primary-color: #00a1d6;\\n    --bpx-primary-bgcolor: transparent;\\n\\n    // --bpx-fn-color: #00a1d6;\\n    // --bpx-fn-hover-color: #00b5e5;\\n\\n    --bpx-tooltip-color: #fff;\\n    --bpx-tooltip-bgcolor: rgba(0, 0, 0, 1);\\n\\n    --bpx-toast-color: #fff;\\n    --bpx-toast-bgcolor: rgba(25, 25, 25, 0.88);\\n    --bpx-toast-fn-color: #f25d8e;\\n    --bpx-toast-fn-hover-color: #ff85ad;\\n    --bpx-toast-font-size: 14px;\\n\\n    --bpx-ui-font-size: 12px;\\n}\\n\",\"@import (reference) '../../base/global';\\n@import (reference) '../../base/theme';\\n\\n.@{ppx}-auxiliary {\\n    /* 防止网页引用的样式覆盖 */\\n    .@{ppx}-bscrollbar {\\n        position: relative;\\n        .bscroll-vertical-scrollbar {\\n            width: 6px !important;\\n        }\\n        .bscroll-indicator {\\n            border: none !important;\\n            background: @color-scroll-bg !important;\\n            cursor: pointer;\\n        }\\n        .bscroll-vertical-scrollbar.mousedown {\\n            opacity: 1 !important;\\n            background: @aux-content-bg !important;\\n        }\\n        &:hover {\\n            .bscroll-vertical-scrollbar {\\n                opacity: 1 !important;\\n                background: @aux-content-bg !important;\\n            }\\n        }\\n    }\\n\\n    .mCSB_inside > .mCSB_container {\\n        margin-right: 0;\\n    }\\n\\n    .bpui-button-type-small {\\n        color: @color-gray-21;\\n        background: @color-grey-input-bg;\\n        border: none;\\n        border-radius: 2px;\\n        &:hover {\\n            color: #fff;\\n            background: @fn-hover-color;\\n        }\\n    }\\n}\\n.@{ppx}-auxiliary {\\n    position: relative;\\n    flex-shrink: 0;\\n    width: 100%;\\n    // overflow: hidden;\\n    // background-color: #fff;\\n    box-sizing: border-box;\\n    height: 100%;\\n    vertical-align: top;\\n\\n    .@{ppx}-collapse {\\n        .bui-collapse-body {\\n            background-color: @aux-content-bg;\\n            position: relative;\\n        }\\n        .@{ppx}-wraplist {\\n            display: block;\\n        }\\n        .bui-collapse-wrap-folded .@{ppx}-modal-container {\\n            display: none !important;\\n        }\\n    }\\n\\n    .@{ppx}-collapse-playlist {\\n        .bui-collapse .bui-collapse-header .bui-collapse-arrow {\\n            color: #999;\\n        }\\n        .@{ppx}-wraplist {\\n            display: block;\\n        }\\n\\n        margin-top: 16px;\\n    }\\n\\n    .@{ppx}-filter {\\n        display: flex;\\n        position: relative;\\n        box-sizing: border-box;\\n        z-index: 2;\\n        height: 46px;\\n        line-height: 46px;\\n        border: none;\\n        border-radius: @normal-border-raduis;\\n        padding: 0 10px 0 16px;\\n        font-size: 16px;\\n        // .clearfix;\\n\\n        .@{ppx}-filter-btn {\\n            border: 1px solid transparent;\\n            border-radius: 0;\\n            width: 100px;\\n            box-sizing: border-box;\\n            line-height: 28px;\\n            height: 30px;\\n            white-space: nowrap;\\n            position: relative;\\n            transition: background-color 0.3s;\\n            z-index: 10;\\n            font-size: 12px;\\n            padding: 0 8px;\\n            text-align: center;\\n            outline: none;\\n            user-select: none;\\n            display: inline-block;\\n            overflow: visible;\\n\\n            &.bpui-state-hover {\\n                z-index: 11;\\n            }\\n\\n            &.bpui-state-disabled {\\n                background-color: #fff;\\n\\n                .@{ppx}-iconfont,\\n                .bpui-button-text {\\n                    color: @color-disabled;\\n                }\\n\\n                &.bpui-state-hover {\\n                    color: @color-disabled;\\n\\n                    .@{ppx}-iconfont,\\n                    .bpui-button-text {\\n                        color: @color-disabled;\\n                    }\\n                }\\n            }\\n\\n            &.active {\\n                cursor: default;\\n                border-bottom: 0;\\n                z-index: 11;\\n                background-color: #fff;\\n                // box-shadow: inset 0 2px 4px @color-grey-input-bg;\\n                & > span {\\n                    color: @fn-color;\\n                    border-bottom: 2px solid @fn-color;\\n                    height: 28px;\\n                    line-height: 28px;\\n                    width: 80%;\\n                    display: inline-block;\\n                }\\n\\n                &.bpui-state-hover {\\n                    cursor: default;\\n                    background-color: #fff;\\n                }\\n            }\\n        }\\n\\n        &-menu {\\n            display: inline-block;\\n            font-size: 16px;\\n            color: @color-gray-75;\\n            position: absolute;\\n            left: 92px;\\n            width: 30px;\\n            height: 100%;\\n            text-align: center;\\n            cursor: pointer;\\n            &:hover {\\n                color: @primary-color;\\n            }\\n        }\\n\\n        &-toggle {\\n            position: absolute;\\n            right: 10px;\\n            color: @color-font-sub;\\n            cursor: pointer;\\n            > i {\\n                margin-left: 2px;\\n            }\\n        }\\n\\n        .@{ppx}-setting-menu-wrap {\\n            position: absolute;\\n            display: none;\\n            z-index: 1;\\n            left: -65px;\\n            top: 35px;\\n            width: 80px;\\n            padding: 8px 0;\\n            border: 1px solid @color-grey-bg;\\n            border-radius: @border-radius-normal;\\n            background-color: #fff;\\n            box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.14);\\n\\n            .@{ppx}-setting-menu-list {\\n                line-height: 36px;\\n                height: 36px;\\n                position: relative;\\n                font-size: 14px;\\n                cursor: pointer;\\n                text-align: center;\\n                color: @color-gray-22;\\n                background-color: #fff;\\n                transition: background-color 0.3s;\\n\\n                &:hover {\\n                    color: @primary-color;\\n                    background-color: @color-gray-e7;\\n                }\\n            }\\n        }\\n        .@{ppx}-video-float-hint {\\n            display: none;\\n            height: 30px;\\n            line-height: 30px;\\n            color: #fff;\\n            white-space: nowrap;\\n            border-radius: @border-radius-normal;\\n            background: rgba(0, 0, 0, 0.7);\\n            padding: 0 10px;\\n        }\\n\\n        .bpl-error {\\n            position: absolute;\\n            z-index: 20;\\n            top: 50%;\\n            width: 100%;\\n            line-height: 20px;\\n            background-color: rgba(78, 78, 78, 0.8);\\n            color: #fff;\\n            font-size: 12px;\\n            text-align: center;\\n            margin-top: -10px;\\n            height: 20px;\\n        }\\n    }\\n\\n    .@{ppx}-wraplist {\\n        display: none;\\n        box-sizing: border-box;\\n        overflow: hidden;\\n        &.mask:after {\\n            content: '';\\n            position: absolute;\\n            top: -60px;\\n            right: 0;\\n            bottom: -200px;\\n            left: 0;\\n            background: rgba(255, 255, 255, 0.4);\\n            cursor: default;\\n            z-index: 2;\\n        }\\n        &.bas-mask:after {\\n            content: '';\\n            position: absolute;\\n            top: 0;\\n            right: 0;\\n            bottom: 0;\\n            left: 0;\\n            background: rgba(255, 255, 255, 0.4);\\n            cursor: default;\\n            z-index: 10003;\\n        }\\n    }\\n\\n    .@{ppx}-danmaku {\\n        overflow: hidden;\\n        position: relative;\\n\\n        &.@{ppx}-bas-mode {\\n            .@{ppx}-danmaku-management,\\n            .@{ppx}-danmaku-btn-footer,\\n            .@{ppx}-panel-close {\\n                display: none;\\n            }\\n\\n            .@{ppx}-danmaku-wrap-child.@{ppx}-danmaku-wrap-child {\\n                top: -10px;\\n            }\\n        }\\n    }\\n\\n    .@{ppx}-panel-title {\\n        padding-left: 22px;\\n        line-height: 60px;\\n        color: @aux-content-font1;\\n        font-size: 14px;\\n        border-bottom: 1px solid @aux-float-border;\\n        text-align: left;\\n        overflow: hidden;\\n\\n        .@{ppx}-panel-close {\\n            cursor: pointer;\\n            position: absolute;\\n            top: 0;\\n            right: 0;\\n            margin-right: 16px;\\n            line-height: 40px;\\n            color: @color-font-sub;\\n            &:hover {\\n                color: @color-gray-22;\\n            }\\n        }\\n\\n        .@{ppx}-panel-back {\\n            cursor: pointer;\\n            position: absolute;\\n            top: 0;\\n            right: 0;\\n            margin-right: 22px;\\n            line-height: 60px;\\n            color: @color-font-sub;\\n\\n            &:hover {\\n                color: @color-gray-22;\\n            }\\n        }\\n    }\\n\\n    .@{ppx}-setting,\\n    .@{ppx}-adv-danmaku {\\n        width: 100%;\\n        background-color: @aux-content-bg;\\n    }\\n\\n    &.video-state-pause .@{ppx}-video-area {\\n        .@{ppx}-state-wrap {\\n            display: block;\\n        }\\n\\n        .@{ppx}-loading-panel {\\n            display: block;\\n        }\\n\\n        &.video-float-mini-mode .@{ppx}-state-wrap {\\n            display: none;\\n        }\\n\\n        .@{ppx}-row-dm-wrap div {\\n            animation-play-state: paused;\\n            -webkit-animation-play-state: paused; /* Safari 和 Chrome */\\n        }\\n    }\\n\\n    &.video-state-buff .@{ppx}-video-area {\\n        .@{ppx}-state-wrap {\\n            display: block;\\n            background: rgba(0, 0, 0, 0.8);\\n            width: 48px;\\n            height: 48px;\\n            left: 50%;\\n            top: 50%;\\n            right: auto;\\n            bottom: auto;\\n            margin-left: -24px;\\n            margin-top: -24px;\\n            text-align: center;\\n            border-radius: @border-radius-normal;\\n\\n            &-play {\\n                display: none;\\n            }\\n\\n            &-buff {\\n                display: inline-block;\\n                margin-top: 8px;\\n                vertical-align: top;\\n            }\\n        }\\n    }\\n\\n    .@{ppx}-contextmenu.@{ppx}-white {\\n        background-color: @aux-float-bg;\\n        box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.14);\\n        border-color: @aux-float-border;\\n\\n        > li {\\n            color: @aux-content-font1;\\n            position: relative;\\n\\n            &:before {\\n                position: absolute;\\n                content: '';\\n                top: 0;\\n                left: 0;\\n                width: 100%;\\n                height: 100%;\\n                opacity: 0.1;\\n            }\\n\\n            &:hover {\\n                background-color: unset;\\n\\n                &:before {\\n                    background-color: @aux-float-hover-bg;\\n                }\\n            }\\n        }\\n    }\\n\\n    // UGC新版播放页右侧弹幕列表样式适配\\n    &[data-revision='1'] {\\n        .@{ppx}-filter {\\n            height: 44px;\\n            line-height: 44px;\\n            font-size: 15px;\\n            font-weight: 500;\\n            border-radius: @revision-aux-border-radius;\\n        }\\n\\n        .@{ppx}-dm-btn-history {\\n            border-radius: @revision-aux-border-radius;\\n        }\\n\\n        .bui-collapse-header {\\n            border-radius: @revision-aux-border-radius;\\n        }\\n\\n        .bui-dropdown-items {\\n            border-radius: @revision-dmsend-input-border-radius;\\n        }\\n\\n        @media screen and (min-width: 1681px) {\\n            .@{ppx}-filter {\\n                font-size: 16px;\\n            }\\n        }\\n    }\\n\\n    &[data-revision='3'] {\\n        .@{ppx}-filter {\\n            height: 44px;\\n            line-height: 44px;\\n            border-radius: 0px;\\n            font-weight: 600;\\n        }\\n\\n        .bui-collapse {\\n            .bui-collapse-header {\\n                border-radius: 0px;\\n                .bui-collapse-arrow {\\n                    right: 22px;\\n                    .bui-collapse-arrow-text {\\n                        .arrow-icon {\\n                            transform: rotate(180deg);\\n                        }\\n                    }\\n                }\\n            }\\n\\n            .bui-collapse-wrap-folded {\\n                .bui-collapse-header {\\n                    .bui-collapse-arrow {\\n                        .bui-collapse-arrow-text {\\n                            .arrow-icon {\\n                                transform: rotateZ(0deg);\\n                            }\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n\\n        .bui-dropdown {\\n            .bui-dropdown-display {\\n                .bui-dropdown-icon:hover {\\n                    fill: unset;\\n                }\\n            }\\n        }\\n    }\\n}\\n\",\".bpx-player-auxiliary {\\n  /* 防止网页引用的样式覆盖 */\\n}\\n.bpx-player-auxiliary .bpx-player-bscrollbar {\\n  position: relative;\\n}\\n.bpx-player-auxiliary .bpx-player-bscrollbar .bscroll-vertical-scrollbar {\\n  width: 6px !important;\\n}\\n.bpx-player-auxiliary .bpx-player-bscrollbar .bscroll-indicator {\\n  border: none !important;\\n  background: #6d7f7a !important;\\n  cursor: pointer;\\n}\\n.bpx-player-auxiliary .bpx-player-bscrollbar .bscroll-vertical-scrollbar.mousedown {\\n  opacity: 1 !important;\\n  background: var(--bpx-aux-content-bg, #ffffff) !important;\\n}\\n.bpx-player-auxiliary .bpx-player-bscrollbar:hover .bscroll-vertical-scrollbar {\\n  opacity: 1 !important;\\n  background: var(--bpx-aux-content-bg, #ffffff) !important;\\n}\\n.bpx-player-auxiliary .mCSB_inside > .mCSB_container {\\n  margin-right: 0;\\n}\\n.bpx-player-auxiliary .bpui-button-type-small {\\n  color: #212121;\\n  background: #f4f5f7;\\n  border: none;\\n  border-radius: 2px;\\n}\\n.bpx-player-auxiliary .bpui-button-type-small:hover {\\n  color: #fff;\\n  background: var(--bpx-fn-hover-color, #00b5e5);\\n}\\n.bpx-player-auxiliary {\\n  position: relative;\\n  flex-shrink: 0;\\n  width: 100%;\\n  box-sizing: border-box;\\n  height: 100%;\\n  vertical-align: top;\\n}\\n.bpx-player-auxiliary .bpx-player-collapse .bui-collapse-body {\\n  background-color: var(--bpx-aux-content-bg, #ffffff);\\n  position: relative;\\n}\\n.bpx-player-auxiliary .bpx-player-collapse .bpx-player-wraplist {\\n  display: block;\\n}\\n.bpx-player-auxiliary .bpx-player-collapse .bui-collapse-wrap-folded .bpx-player-modal-container {\\n  display: none !important;\\n}\\n.bpx-player-auxiliary .bpx-player-collapse-playlist {\\n  margin-top: 16px;\\n}\\n.bpx-player-auxiliary .bpx-player-collapse-playlist .bui-collapse .bui-collapse-header .bui-collapse-arrow {\\n  color: #999;\\n}\\n.bpx-player-auxiliary .bpx-player-collapse-playlist .bpx-player-wraplist {\\n  display: block;\\n}\\n.bpx-player-auxiliary .bpx-player-filter {\\n  display: flex;\\n  position: relative;\\n  box-sizing: border-box;\\n  z-index: 2;\\n  height: 46px;\\n  line-height: 46px;\\n  border: none;\\n  border-radius: 2px;\\n  padding: 0 10px 0 16px;\\n  font-size: 16px;\\n}\\n.bpx-player-auxiliary .bpx-player-filter .bpx-player-filter-btn {\\n  border: 1px solid transparent;\\n  border-radius: 0;\\n  width: 100px;\\n  box-sizing: border-box;\\n  line-height: 28px;\\n  height: 30