            "text": "{\"code\":0,\"data\":{\"relates\":[],\"season\":[{\"actor\":\"赛罗·弗巴茨：阿座上洋平、缇欧丽塔：饭冢麻结、芭特谢·基维亚：石上静香、多塔·鲁兹拉斯：堀江瞬、维内蒂姆·里奥普尔：土岐隼一、诺伽尤·森里基：上田燿司、达也：松冈祯丞、渣布：福岛润、杰斯·帕提拉克特：千叶翔也、妮莉：日笠阳子\",\"badge\":\"独家\",\"badge_info\":{\"bg_color\":\"#00C0FF\",\"bg_color_night\":\"#0B91BE\",\"text\":\"独家\"},\"badge_type\":1,\"cover\":\"https://i0.hdslb.com/bfs/bangumi/image/468f36b158d19139d237fc5411ab091994558605.png\",\"enable_vt\":false,\"from\":0,\"icon_font\":{\"name\":\"playdata-square-line@500\",\"text\":\"1804.9万\"},\"new_ep\":{\"cover\":\"http://i0.hdslb.com/bfs/archive/8d05c8beec7b0456c6c761a9381a6b44c2e532aa.png\",\"index_show\":\"更新至第7话\"},\"rating\":{\"count\":2456,\"score\":9.6},\"rcmd_reason\":\"\",\"report\":{\"is_wtgt\":0,\"seriesId\":7921},\"rights\":{\"can_watch\":1,\"resource\":\"\"},\"season_id\":127870,\"season_type\":1,\"stat\":{\"danmaku\":46093,\"follow\":553889,\"view\":18049013,\"vt\":0,\"vtForUnity\":146177},\"styles\":[{\"id\":10012,\"name\":\"小说改\"},{\"id\":10020,\"name\":\"战斗\"},{\"id\":10018,\"name\":\"奇幻\"}],\"subtitle\":\"惩罚勇者拯救世界\",\"title\":\"判处勇者刑\",\"url\":\"https://www.bilibili.com/bangumi/play/ss127870\",\"user_status\":{\"follow\":0}},{\"actor\":\"铃木：铃代纱弓、谷：坂田将吾、渡边：谷口梦奈、佐藤：平林瑚夏、山田：岩田安司、东：岛袋美由利、平：加藤涉、西：大森心、本田：楠木灯\",\"badge\":\"独家\",\"badge_info\":{\"bg_color\":\"#00C0FF\",\"bg_color_night\":\"#0B91BE\",\"text\":\"独家\"},\"badge_type\":1,\"cover\":\"https://i0.hdslb.com/bfs/bangumi/image/9900ebe9d5ede20aaaf27131c07424587461a4b5.png\",\"enable_vt\":false,\"from\":0,\"icon_font\":{\"name\":\"playdata-square-line@500\",\"text\":\"1296.2万\"},\"new_ep\":{\"cover\":\"http://i0.hdslb.com/bfs/archive/a7986a582fb7ff8832ab1b7c2fa4917e3cc2caa6.png\",\"index_show\":\"更新至第6话\"},\"rating\":{\"count\":8175,\"score\":9.8},\"rcmd_reason\":\"\",\"report\":{\"is_wtgt\":0,\"seriesId\":7944},\"rights\":{\"can_watch\":1,\"resource\":\"\"},\"season_id\":129142,\"season_type\":1,\"stat\":{\"danmaku\":57496,\"follow\":531363,\"view\":12961731,\"vt\":0,\"vtFo